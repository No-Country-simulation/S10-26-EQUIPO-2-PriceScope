# URL de conexión a la base de datos local o remota
DATABASE_URL="postgresql://<tu_usuario>:<tu_contraseña>@<tu_host>:<tu_puerto>/<tu_db_name>"

# Variables de entorno individuales para la conexión PostgreSQL / TimescaleDB
DB_HOST=localhost
DB_PORT=puerto
DB_USER=usuario_de_la_bd
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=nombre_de_la_bd