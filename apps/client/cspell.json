{
  "version": "0.2",
  "language": "en,es",
  "dictionaries": ["es-es"],
  "caseSensitive": false,
  "import": ["@cspell/dict-es-es/cspell-ext.json"],
  "ignorePaths": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "build/**",
    "package-lock.json",
    "next-env.d.ts",
    "tsconfig.tsbuildinfo",
    "public/**",
    "src/mocks/**"
  ],
  "ignoreRegExpList": [
    "/[a-z]+_[a-z0-9_]+/g",
    "/[a-z]+-[a-z0-9-]+/g",
    "/https?:\\/\\/[^\\s\"']+/g"
  ],
  "patterns": [
    {
      "name": "JSXText",
      "pattern": "/>([^<>{]+)</g"
    }
  ],
  "languageSettings": [
    {
      "languageId": "typescript",
      "includeRegExpList": ["CStyleComment", "string"]
    },
    {
      "languageId": "typescriptreact",
      "includeRegExpList": ["CStyleComment", "string", "JSXText"]
    },
    {
      "languageId": "javascript",
      "includeRegExpList": ["CStyleComment", "string"]
    },
    {
      "languageId": "javascriptreact",
      "includeRegExpList": ["CStyleComment", "string", "JSXText"]
    }
  ],
