{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Hangfire": {
    "WorkerCount": 4,
    "Retry": {
      "Attempts": 4,
      "DelaysInSeconds": [120, 240, 480, 960]
    },
    "RecurringJobs": {
      "DailyScraper": {
        "CronExpression": "0 6 * * *",
        "TimeZoneId": "America/Argentina/Buenos_Aires"
      }
    }
  }
}
  